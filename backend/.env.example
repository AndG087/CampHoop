DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIE=false
# Generate a local password with scripts/configure_local.py. No default password.
DEMO_PASSWORD=

# Local development and public links used by account emails.
APP_ENV=development
APP_URL=http://localhost:5173
# auto: optional SMTP, otherwise local capture in development.
MAIL_TRANSPORT=auto
# Optional in development (a key is created under data/). Required in production.
MAIL_ENCRYPTION_KEY=

# Optional: configure a mail provider only when you want real email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
