DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIE=false
# Generate a local password with scripts/configure_local.py. No default password.
DEMO_PASSWORD=

# Local development and public links used by account emails.
APP_ENV=development
APP_URL=http://localhost:5173
# auto: Gmail OAuth when connected, then SMTP, then local capture in development.
MAIL_TRANSPORT=auto
# Optional in development (a key is created under data/). Required in production.
MAIL_ENCRYPTION_KEY=

# Google Cloud OAuth client: Web application. Keep the secret on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Only this verified account can authorize the application-wide Gmail sender.
GMAIL_SENDER=

# Optional SMTP fallback; Gmail OAuth does not require an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
